{
  "name": "kyra",
  "version": "1.11.1",
  "private": true,
  "description": "Kyra Overlay - A BedWars Stats Overlay",
  "scripts": {
    "dev": "tauri dev",
    "renderer:dev": "vite --config vite.config.ts",
    "build": "vue-tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "e2e": "playwright test",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "lint": "eslint src --max-warnings 9999",
    "lint:fix": "eslint src --fix --max-warnings 9999",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\"",
    "typecheck": "vue-tsc --noEmit",
    "codemod": "npm --prefix codemods run codemod",
    "fix": "npm run codemod && npm run typecheck && npm run lint:fix && npm run format",
    "knip": "knip"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.12",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.1.1",
    "radix-vue": "^1.9.9",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-format": "^2.0.1",
    "knip": "^6.34.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.28.2": true
  },
  "trustedDependencies": []
}
