{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kyra Overlay",
  "version": "1.11.1",
  "identifier": "com.thebois.overlay",
  "build": {
    "beforeDevCommand": "npm run renderer:dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kyra Overlay",
        "width": 1280,
        "height": 720,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "targets": ["nsis", "dmg", "appimage"],
    "resources": ["../resources/**/*"]
  }
}
